# PostgreSQL connection string from Neon or Prisma Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Admin credentials - use strong unique values in Vercel
ADMIN_PASSWORD=change_me_admin
EDITOR_PASSWORD=change_me_editor

# At least 32 random characters
AUTH_SECRET=change_me_to_a_random_secret_at_least_32_chars

# Automatically provided when a Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
